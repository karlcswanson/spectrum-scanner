# Spectrum Scanner — deployment configuration
# Copy to .env and fill in. ONE file serves BOTH modes (public internet and
# local-network / offline); only the "Network / TLS" block below changes.
# Deploy either way with the same command:
#   docker compose -f docker-compose.prod.yml up -d

# ═════════════════════════════════════════════════════════════════════════════
# Network / TLS  —  one set of vars, filled in per your deployment mode
# ═════════════════════════════════════════════════════════════════════════════
# Both modes run HTTPS, so session/CSRF cookies work with no code changes. Set
# the five vars below to match ONE of these:
#
#   PUBLIC INTERNET  (real domain, automatic Let's Encrypt)
#     DOMAIN=your-domain.com
#     SITE_TLS=                              (leave empty → Let's Encrypt)
#     ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,server
#     CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS = https://your-domain.com
#
#   LOCAL NETWORK / OFFLINE  (no DNS → use the server's LAN IP; self-signed cert)
#     DOMAIN=192.168.1.50                    (the server's LAN IP; give it a
#                                             static IP / DHCP reservation)
#     SITE_TLS=tls internal                  (Caddy signs from its local CA;
#                                             trust its root on clients, or
#                                             click through the warning)
#     ALLOWED_HOSTS=*                        (safe on a trusted/offline LAN)
#     CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS = https://192.168.1.50
#                                             (must be the exact IP + scheme;
#                                             Django can't wildcard these)

DOMAIN=your-domain.com
SITE_TLS=
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,server
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ═════════════════════════════════════════════════════════════════════════════
# Django
# ═════════════════════════════════════════════════════════════════════════════
DEBUG=false
# Generate an env-safe secret (URL-safe chars only, no #/$ that would break .env):
#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# ═════════════════════════════════════════════════════════════════════════════
# Database (PostgreSQL)
# ═════════════════════════════════════════════════════════════════════════════
DB_NAME=spectrum
DB_USER=spectrum
DB_PASSWORD=change-this-db-password

# ═════════════════════════════════════════════════════════════════════════════
# MQTT broker
# ═════════════════════════════════════════════════════════════════════════════
# The broker address is fixed by the compose topology (internal mosquitto:1883,
# plus :9001 WebSocket via Caddy), so there's nothing to set for it here.

# Dynamic Security admin — provisions broker users/ACLs (REQUIRED; compose fails
# to start without a password set here).
MOSQUITTO_DYNSEC_USERNAME=admin
MOSQUITTO_DYNSEC_PASSWORD=change-this-dynsec-password

# Bridge service that ingests scans into the database.
MQTT_BRIDGE_USERNAME=spectrum-bridge
MQTT_BRIDGE_PASSWORD=change-this-bridge-password

# Note: browser and scanner MQTT logins are NOT configured here. The broker runs
# with allow_anonymous=false and provisions per-user credentials dynamically via
# the Dynamic Security plugin — browsers fetch theirs from GET /api/mqtt/credentials/
# (authenticated users, including share-link demo_viewer sessions), and each
# scanner gets its own token when it's registered.

# ═════════════════════════════════════════════════════════════════════════════
# Optional overrides — all have working defaults; uncomment only to change
# ═════════════════════════════════════════════════════════════════════════════
#REDIS_URL=redis://redis:6379/0
#SERVER_TAG=latest                 # GHCR image tags — pin to a version to lock deploys
#FRONTEND_TAG=latest
#SERVER_MEM_LIMIT=2g               # per-container memory caps
#BRIDGE_MEM_LIMIT=1g
#SCHEDULER_MEM_LIMIT=1g
#PG_SHARED_BUFFERS=256MB           # Postgres tuning (raise with host RAM)
#PG_EFFECTIVE_CACHE_SIZE=768MB
