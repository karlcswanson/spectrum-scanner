# Production Caddyfile for Spectrum Scanner
# HTTPS via Let's Encrypt (public) or a self-signed internal CA (LAN) — see
# SITE_TLS in .env.

{
    # Serve the correct cert to clients that connect by bare IP. An IP connection
    # sends no SNI, so without this Caddy can't select a cert and aborts the TLS
    # handshake (browsers show ERR_SSL_PROTOCOL_ERROR). Fall back to DOMAIN as the
    # server name; harmless for hostname/public access, where real SNI is sent.
    default_sni {$DOMAIN:localhost}
}

{$DOMAIN:localhost} {
    # TLS mode is env-driven so ONE Caddyfile serves both deployments:
    #   public  → SITE_TLS empty        → automatic Let's Encrypt
    #   LAN     → SITE_TLS="tls internal" → Caddy's self-signed local CA
    {$SITE_TLS:}

    # Compress responses (the scan/history JSON payloads gzip/zstd very well).
    encode zstd gzip

    # API routes to Django backend
    handle /api/* {
        reverse_proxy server:8000
    }

    # Django admin
    handle /admin/* {
        reverse_proxy server:8000
    }

    # Share links (read-only demo access)
    handle /share/* {
        reverse_proxy server:8000
    }

    # MQTT WebSocket proxy
    handle /mqtt {
        reverse_proxy mosquitto:9001 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static files (Django admin + collected static)
    handle /static/* {
        root * /srv
        file_server
    }

    # Everything else goes to the Vue frontend
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    # Logging
    log {
        output stdout
        format console
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
