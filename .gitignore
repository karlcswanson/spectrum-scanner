scanner/cmd/desktop/build/
scanner/cmd/desktop/frontend/dist/
scanner/cmd/desktop/frontend/node_modules/
scanner/cmd/desktop/frontend/package.json.md5

# Embedded web assets (generated from frontend build)
scanner/internal/api/web/assets/
scanner/internal/api/web/index.html

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-standalone/

# Python cache
__pycache__/
*.pyc
.venv/

# Django collectstatic output
server/staticfiles/

# GoReleaser
dist/

# SQLite database
*.sqlite3
server/data/*.sqlite3

# OS files
.DS_Store

# SSH artifacts
scanner/root@*

# Environment files with secrets
.env
!.env.example

# Local scanner config (contains credentials)
config.yaml
!config.yaml.example
/scanner/calibration.yaml

# Root-level local tooling: a ~1.6GB scans.db, a Python venv, and calibration
# scripts. Anchored to the repo root so it does NOT also match ios/tools/ — those
# capture/screenshot scripts ARE tracked; only their generated output is ignored
# (see the iOS section below).
/tools/

# Editor / backup scratch files
*.bak

# iOS local code signing (contains user's Apple Developer Team ID)
ios/Signing.xcconfig

# ---------- iOS / Xcode ----------

# Generated by xcodegen — sources of truth are project.yml + the source tree.
# Anyone cloning runs `xcodegen generate` once before opening Xcode.
ios/SpectrumScanner.xcodeproj/

# Xcode user-specific state (cursor positions, open files, breakpoints,
# scheme run state, last-open tabs). Changes every Xcode interaction.
**/*.xcuserstate
**/xcuserdata/
**/*.xcuserdatad/

# Xcode workspace metadata (regenerated automatically)
**/*.xcworkspace/xcshareddata/swiftpm/
**/*.xcworkspace/xcuserdata/

# Local build outputs / archive products
ios/build/
ios/DerivedData/
# Scripted `xcodebuild -derivedDataPath simbuild` output (~130MB, thousands of files)
ios/simbuild/
*.ipa
*.dSYM.zip

# xcodebuild test result bundles (e.g. from the screenshot UITest run)
**/*.xcresult

# Instruments traces — large binary bundles, captured per-session
ios/profiles/
ios/tools/traces/

# App Store screenshot output from ios/tools/screenshots.sh — the script is tracked,
# the generated per-device PNGs + result bundles are not.
ios/tools/screenshots/

# Demo dataset capture-export staging (the bundled file lives at
# ios/SpectrumScanner/Resources/demo_scans.json and IS committed; this
# ignores the per-device tmp copy the Developer export action drops)
ios/SpectrumScanner/**/demo_scans.tmp.json

# Swift package resolution cache (committed alongside project.yml is fine,
# but DerivedData duplicates are not)
**/Package.resolved.lock
