# Observability worker config — copy to .env and fill in.
# .env is gitignored; keep real endpoints/secrets there, not in this template.

# --- VictoriaMetrics (or any InfluxDB-line-protocol write endpoint) ------------
# Telegraf POSTs to <VM_URL>/write. Basic-auth optional (leave blank for none).
VM_URL=https://vm.example.com
VM_USERNAME=
VM_PASSWORD=

# --- broker ($SYS) + Caddy HTTP metrics ---------------------------------------
# Reached by service name over the server stack's docker network (telegraf joins
# it — see docker-compose.yml + SERVER_NETWORK). The server stack must be up first.
MQTT_URL=tcp://mosquitto:1883
CADDY_METRICS_URL=http://caddy:2020/metrics
# Read-only monitoring user — provisioned automatically by the server (see README).
MQTT_MONITOR_USERNAME=monitor
MQTT_MONITOR_PASSWORD=change-me

# --- labels / network ---------------------------------------------------------
# Tags every metric with host=<this>, so multiple deployments stay distinct.
TELEGRAF_HOSTNAME=spectrum-demo
# The server stack's docker network (compose project "server" -> "server_default").
SERVER_NETWORK=server_default

# Host docker group id, for docker.sock access: getent group docker | cut -d: -f3
DOCKER_GID=999
