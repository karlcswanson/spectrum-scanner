# Spectrum Scanner Production Configuration
# Copy this file to .env and update the values

# Domain for Caddy (set to your domain for auto HTTPS, or localhost for local testing)
DOMAIN=localhost

# Django settings
DEBUG=false
DJANGO_SECRET_KEY=your-secret-key-change-me-in-production
# NOTE: Must include 'localhost' and 'server' for internal Mosquitto auth requests
ALLOWED_HOSTS=your-domain.com,localhost,server

# Database (SQLite for POC, PostgreSQL for production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/data/db.sqlite3
# For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=spectrum
# DB_USER=spectrum
# DB_PASSWORD=your-db-password
# DB_HOST=postgres
# DB_PORT=5432

# MQTT settings
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# MQTT bridge service credentials (internal service that saves scans to database)
MQTT_BRIDGE_USERNAME=spectrum-bridge
MQTT_BRIDGE_PASSWORD=change-this-bridge-password

# MQTT scanner credentials (for scanners connecting to the broker)
# These are used by the Django auth backend for MQTT
# Scanners authenticate via: username=scanner-{id}, password=scanner-token
SCANNER_DEFAULT_TOKEN=change-this-scanner-token

# MQTT frontend credentials (for browser WebSocket connections)
# The frontend uses anonymous read-only access by default
# Set these if you want authenticated browser connections
# MQTT_FRONTEND_USERNAME=frontend
# MQTT_FRONTEND_PASSWORD=frontend-password

# CORS (add your frontend domain)
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
