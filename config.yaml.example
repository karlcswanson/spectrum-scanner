# Spectrum Scanner Configuration
# Copy this to config.yaml and customize for your setup

# Auto-start scanning when the scanner boots
auto_start: true

# Scan settings
dwell_time_ms: 200
mode: Average  # Average or PeakDetect

# Gain settings
# Use manual mode for consistent sweeps across the spectrum
rx_gain: 30           # RX gain in dB (0-73)
rx_gain_mode: Manual  # manual, slow_attack, or fast_attack

# Frequency bands to scan
# Each band can be enabled/disabled independently
bands:
  - name: Business Radio
    start_mhz: 450
    stop_mhz: 470
    enabled: true

  - name: UHF
    start_mhz: 470
    stop_mhz: 608
    enabled: true

  - name: DECT
    start_mhz: 1920
    stop_mhz: 1930
    enabled: true

  - name: WiFi 2.4
    start_mhz: 2400
    stop_mhz: 2500
    enabled: true

  - name: WiFi 5
    start_mhz: 5150
    stop_mhz: 5850
    enabled: false

# Add custom bands as needed:
#  - name: ISM 900
#    start_mhz: 902
#    stop_mhz: 928
#    enabled: false

# MQTT publishing (optional)
# Configure to publish scan data to a central server
mqtt:
  enabled: false  # Set to true and configure below

  broker: "tcp://localhost:1883"
  id: "your-scanner-uuid"        # Get from Django admin after creating scanner
  token: "your-scanner-token"    # Get from Django admin after creating scanner

  # Display info
  name: "My Scanner"             # Human-readable name (e.g., "Studio A Scanner")
  location: "My Location"        # Physical location (e.g., "Studio A", "Main Stage")
  # topic_prefix: "spectrum"     # Default: "spectrum"
